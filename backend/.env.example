# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Frontend URL (CORS allowed origins, comma-separated)
FRONTEND_URL=http://localhost:5173

# Optional API key for mutation endpoints (/upload, DELETE /documents/*)
# Leave blank to allow open access during local development
APP_API_KEY=
